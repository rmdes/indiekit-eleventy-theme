{#
  CV Languages Section
  Data fetched from /cv/data.json via homepage plugin
#}

{% if cv and cv.languages and cv.languages.length %}
<section class="mb-8 sm:mb-12" id="languages">
  <h2 class="text-xl sm:text-2xl font-bold text-heading mb-4 sm:mb-6">
    {{ section.config.title or "Languages" }}
  </h2>

  <div class="flex flex-wrap gap-3">
    {% for lang in cv.languages %}
    <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-50 dark:bg-surface-800 rounded-full border border-border">
      <span class="font-medium text-sm text-heading">{{ lang.name }}</span>
      <span class="text-xs text-fg-muted capitalize">{{ lang.level }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
